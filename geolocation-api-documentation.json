                                        "description": "Filter by region ID",
                                        "example": 1
                                    },
                                    "province_ID": {
                                        "type": "integer",
                                        "description": "Filter by specific province ID",
                                        "example": 1
                                    },
                                    "search": {
                                        "type": "string",
                                        "description": "Search term to filter provinces by name",
                                        "example": "Cebu"
                                    },
                                    "offset": {
                                        "type": "integer",
                                        "description": "Number of items to skip",
                                        "minimum": 0,
                                        "default": 0,
                                        "example": 0
                                    },
                                    "limit": {
                                        "type": "integer",
                                        "description": "Number of items per page",
                                        "minimum": 1,
                                        "maximum": 100,
                                        "default": 10,
                                        "example": 10
