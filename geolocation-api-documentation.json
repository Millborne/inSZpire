                "summary": "Get list of barangays",
                "description": "Retrieve a paginated list of barangays with optional filtering and search capabilities",
                "tags": ["Barangays"],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "city_municipality_ID": {
                                        "type": "integer",
                                        "description": "Filter by city/municipality ID",
                                        "example": 1
                                    },
                                    "barangay_ID": {
                                        "type": "integer",
                                        "description": "Filter by specific barangay ID",
                                        "example": 1
                                    },
                                    "search": {
                                        "type": "string",
                                        "description": "Search term to filter barangays by name",
                                        "example": "San Antonio"
                                    },
                                    "offset": {
