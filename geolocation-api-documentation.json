                                            "items": {
                                                "$ref": "#/components/schemas/Barangay"
                                            }
                                        },
                                        "total": {
                                            "type": "integer",
                                            "description": "Total number of barangays matching the criteria",
                                            "example": 42029
                                        },
                                        "offset": {
                                            "type": "integer",
                                            "example": 0
                                        },
                                        "limit": {
                                            "type": "integer",
                                            "example": 10
