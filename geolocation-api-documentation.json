    },
    "components": {
        "schemas": {
            "Country": {
                "type": "object",
                "properties": {
                    "country_ID": {
                        "type": "integer",
                        "description": "Unique identifier for the country",
                        "example": 1
                    },
                    "country_code": {
                        "type": "string",
                        "description": "ISO country code",
                        "example": "PH"
                    },
                    "country_name": {
                        "type": "string",
                        "description": "Name of the country",
                        "example": "Philippines"
                    }
                },
                "required": ["country_ID", "country_code", "country_name"]
            },
            "RegionState": {
                "type": "object",
                "properties": {
                    "region_state_ID": {
                        "type": "integer",
                        "description": "Unique identifier for the region/state",
                        "example": 1
                    },
                    "region_name": {
                        "type": "string",
                        "description": "Name of the region/state",
                        "example": "National Capital Region"
                    },
                    "country_ID": {
                        "type": "integer",
                        "description": "ID of the country this region belongs to",
                        "example": 1
                    }
                },
                "required": ["region_state_ID", "region_name", "country_ID"]
            },
            "Province": {
                "type": "object",
                "properties": {
                    "province_ID": {
                        "type": "integer",
                        "description": "Unique identifier for the province",
                        "example": 1
                    },
                    "province_name": {
                        "type": "string",
                        "description": "Name of the province",
                        "example": "Cebu"
                    },
                    "region_ID": {
                        "type": "integer",
                        "description": "ID of the region this province belongs to",
                        "example": 7
                    }
                },
                "required": ["province_ID", "province_name", "region_ID"]
            },
            "Municipality": {
                "type": "object",
                "properties": {
                    "city_municipality_ID": {
                        "type": "integer",
                        "description": "Unique identifier for the municipality",
                        "example": 1
                    },
                    "city_municipality_name": {
                        "type": "string",
                        "description": "Name of the municipality",
                        "example": "Cebu City"
                    },
                    "province_ID": {
                        "type": "integer",
                        "description": "ID of the province this municipality belongs to",
                        "example": 1
                    },
                    "region_ID": {
                        "type": "integer",
                        "description": "ID of the region this municipality belongs to",
                        "example": 7
                    }
                },
                "required": [
                    "city_municipality_ID",
                    "city_municipality_name",
                    "province_ID",
                    "region_ID"
                ]
            },
            "Barangay": {
                "type": "object",
                "properties": {
                    "barangay_ID": {
                        "type": "integer",
                        "description": "Unique identifier for the barangay",
                        "example": 1
                    },
                    "barangay_name": {
                        "type": "string",
                        "description": "Name of the barangay",
                        "example": "San Antonio"
                    },
                    "city_municipality_ID": {
                        "type": "integer",
                        "description": "ID of the city/municipality this barangay belongs to",
                        "example": 1
                    }
                },
                "required": [
                    "barangay_ID",
                    "barangay_name",
                    "city_municipality_ID"
                ]
            },
            "Error": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "description": "Error message",
                        "example": "Internal Server Error"
                    }
                },
                "required": ["success", "message"]
            }
        },
        "parameters": {
            "PageParam": {
                "name": "page",
                "in": "query",
                "description": "Page number for pagination",
                "required": false,
                "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                }
            },
            "LimitParam": {
                "name": "limit",
                "in": "query",
                "description": "Number of items per page",
                "required": false,
                "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 10
                }
            }
        }
    },
    "tags": [
        {
            "name": "Countries",
            "description": "Operations related to countries"
        },
        {
            "name": "Region States",
            "description": "Operations related to regions and states"
        },
        {
            "name": "Provinces",
            "description": "Operations related to provinces"
        },
        {
            "name": "Municipalities",
            "description": "Operations related to municipalities and cities"
        },
        {
            "name": "Barangays",
            "description": "Operations related to barangays"
        }
    ],
    "externalDocs": {
        "description": "Find more info about the Geolocation Service API",
        "url": "https://github.com/your-repo/sz-geolocation"
    }
}
