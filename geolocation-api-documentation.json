{
    "openapi": "3.0.0",
    "info": {
        "title": "Geolocation Service API",
        "description": "A RESTful API for managing geographical data including countries, regions/states, provinces, municipalities, and barangays",
        "version": "1.0.0",
        "contact": {
            "name": "API Support",
            "email": "support@geolocation-service.com"
        },
        "license": {
            "name": "ISC",
            "url": "https://opensource.org/licenses/ISC"
        }
    },
    "servers": [
        {
            "url": "http://localhost:3000",
            "description": "Development server"
        },
        {
            "url": "https://api.geolocation-service.com",
            "description": "Production server"
        }
    ],
    "paths": {
        "/api/countries/view": {
            "post": {
                "summary": "Get list of countries",
                "description": "Retrieve a paginated list of countries with optional search and sorting capabilities",
                "tags": ["Countries"],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "search": {
                                        "type": "string",
                                        "description": "Search term to filter countries by name or code",
                                        "example": "Philippines"
                                    },
                                    "page": {
                                        "type": "integer",
                                        "description": "Page number for pagination",
                                        "minimum": 1,
                                        "default": 1,
                                        "example": 1
                                    },
                                    "limit": {
                                        "type": "integer",
                                        "description": "Number of items per page",
                                        "minimum": 1,
                                        "maximum": 100,
                                        "default": 10,
                                        "example": 10
                                    },
                                    "is_archived": {
                                        "type": "boolean",
                                        "description": "Filter by archived status",
                                        "example": false
                                    },
                                    "sortBy": {
                                        "type": "string",
                                        "description": "Field to sort by",
                                        "enum": [
                                            "country_name",
                                            "country_code"
                                        ],
                                        "default": "country_name",
                                        "example": "country_name"
                                    },
                                    "sortOrder": {
                                        "type": "string",
                                        "description": "Sort order",
                                        "enum": ["ASC", "DESC"],
                                        "default": "ASC",
                                        "example": "ASC"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Countries retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Countries retrieved successfully"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Country"
                                            }
                                        },
                                        "total": {
                                            "type": "integer",
                                            "description": "Total number of countries matching the criteria",
                                            "example": 195
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Internal Server Error"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/region-states/view": {
