                "summary": "Get list of region states",
                "description": "Retrieve a paginated list of region states with optional search and sorting capabilities",
                "tags": ["Region States"],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
